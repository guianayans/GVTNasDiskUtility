# Backend / Server
NODE_ENV=production
HOST=0.0.0.0
PORT=3010
APP_PASSWORD=
PUBLIC_BASE_URL=http://localhost:3010
PUBLIC_SMB_HOST=
SAMBA_CONFIG_PATH=/etc/samba/smb.conf
NAS_SMB_USER=nasuser
NAS_SMB_GROUP=nasuser
NAS_SMB_PASSWORD=
MOUNT_BASE=/media/gvtnas
MIN_DEVICE_BYTES=3221225472
ALLOWED_MOUNT_ROOTS=/mnt,/media
SHARE_STATE_PATH=
SAMBA_USERNAME_MAP=/etc/samba/username.map

# VPN embutida (container "wireguard", porta 51820/udp): 1 = ligada, 0 = desligada
WIREGUARD=1

# Frontend
VITE_API_BASE_URL=http://localhost:3010
VITE_APP_PASSWORD=
